PORT=3000
NODE_ENV=development
TIME_LIMIT=60
SESSION_CLEANUP_GRACE_MS=30000

# Use memory to skip Redis entirely (single-instance demos)
# SESSION_STORE=memory

# Local docker-compose Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Or a single URL, e.g. Redis Cloud
# REDIS_URL=redis://default:password@host:port
# REDIS_PASSWORD=

# Comma-separated origins. Omit to reflect the request origin.
# CORS_ORIGIN=https://www.bytethebug.com
